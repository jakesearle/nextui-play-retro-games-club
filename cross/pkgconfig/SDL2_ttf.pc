# Missing from the toolchain sysroot; paths mirror its sdl2.pc.
prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: SDL2_ttf
Description: TrueType font rendering for SDL2
Version: 2.0.15
Requires: sdl2
Libs: -L${libdir} -lSDL2_ttf
Cflags: -I${includedir}/SDL2
