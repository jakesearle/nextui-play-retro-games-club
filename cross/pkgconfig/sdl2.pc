# The sysroot's copy, minus its -Wl,-rpath,/usr/lib: the binary must load
# whichever SDL2 the firmware it lands on provides.
prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl2
Description: Simple DirectMedia Layer
Version: 2.26.1
Libs: -L${libdir} -lSDL2
Libs.private: -lm -ldl -lpthread
Cflags: -I${includedir} -I${includedir}/SDL2 -D_REENTRANT
